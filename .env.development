# Port the development backend listens on.
#
# In `vite dev` (i.e. `npm run dev` -> `tauri dev`) the backend is started by
# hand with `npm run dev:backend`, which is `bun --watch` on this fixed port.
# Vite only loads this file in dev mode; production builds ignore it and ask
# Rust for the port instead (the sidecar gets PORT=0, so the OS picks one).
VITE_BACKEND_PORT=4317
