# Environment variables read by the backend.
# Copy to .env for local development; the packaged app gets these from Rust.

# SQLite database location. Defaults to prisma/dev.db for the CLI and to the
# platform app data folder for the compiled binary.
# DATABASE_URL="file:./prisma/dev.db"

# 0 lets the OS pick a free port (what Rust uses). Dev uses 4317.
# PORT=0

# Defaults to 127.0.0.1; the backend is never exposed on the network.
# HOST=127.0.0.1

# Optional shared secret. When set, every request must send X-Backend-Token.
# BACKEND_TOKEN=

# Optional CORS allowlist override, comma separated.
# ALLOWED_ORIGINS=http://localhost:1420,tauri://localhost

# Exits when stdin closes (the Tauri parent died). Auto-detected when stdin is
# a pipe; force with 1, disable with 0.
# BACKEND_STDIN_WATCHDOG=auto
