// Prisma schema for the PDF Focus Viewer backend.
// The connection URL lives in prisma.config.ts, not here.
//
// Model and field names are also the database names: there is no @map / @@map
// to keep in sync, so snake_case here is snake_case in SQLite and in the
// generated client.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  runtime      = "bun"
  moduleFormat = "esm"
}

datasource db {
  provider = "sqlite"
}

model pdf_document {
  id               Int               @id @default(autoincrement())
  name             String // editable later
  file_path        String            @unique
  fingerprint      String? // pdf.js fingerprint of the copy, recorded when it is opened
  page_count       Int?
  /// sha256 of the bytes; the copy is library/<content_hash>.pdf
  content_hash     String?           @unique
  /// where the file was imported from, shown in the UI only
  original_path    String?
  created_at       Float // unix epoch milliseconds, written by the API
  folders          folder[]
  focusable_strips focusable_strip[]

  @@index([id])
}

/// A named group of strips inside one document. The document owns its folders;
/// a folder owns its strips. `ordering` is the drag position among the
/// document's folders, rewritten as 0..n-1 when the user reorders them.
model folder {
  id               Int               @id @default(autoincrement())
  pdf_document_id  Int
  pdf_document     pdf_document      @relation(fields: [pdf_document_id], references: [id], onDelete: Cascade)
  name             String
  ordering         Int
  created_at       Float // unix epoch milliseconds, written by the API
  focusable_strips focusable_strip[]

  @@index([id])
  @@index([pdf_document_id, ordering])
}

/// A saved focus strip. It belongs to one document; its folder is optional, so
/// a strip can sit outside every folder ("no folder"). `ordering` is the drag
/// position among the strips that share a home, folder or not.
model focusable_strip {
  id              Int          @id @default(autoincrement())
  pdf_document_id Int
  pdf_document    pdf_document @relation(fields: [pdf_document_id], references: [id], onDelete: Cascade)
  /// Null means the strip is in no folder.
  folder_id       Int?
  folder          folder?      @relation(fields: [folder_id], references: [id], onDelete: Cascade)
  ordering        Int // drag position among the strips of this folder, 0..n-1
  page_number     Int // 1-based, same as data-page
  top             Float // position on the page in PDF points, so zoom doesn't matter
  height          Float
  left            Float // column edges, used to place the note marker
  width           Float
  page_width      Float
  page_height     Float
  text_excerpt    String? // first ~200 chars: list label and backup locator
  remark          String       @default("") // markdown
  created_at      Float // unix epoch milliseconds, written by the API

  @@index([folder_id, ordering])
  @@index([pdf_document_id, ordering])
}

/// App-level UI state that has to survive a restart: one row per key.
///
/// Values are strings so a new remembered setting needs no migration; the
/// client parses what it wrote. Rows are written with `PUT /app-state/:key`.
model app_state {
  key        String @id
  value      String
  updated_at Float // unix epoch milliseconds, written by the API
}

/// Legacy audit table in the business database. New audit rows go to
/// `prisma/audit/schema.prisma` and `audit.db`. The table stays in existing
/// business databases so old rows are not dropped during an upgrade.
/// Change the audit model in the audit schema, not here.
model event_audit {
  id                 Int     @id @default(autoincrement())
  request_id         String
  kind               String // "command" | "event"
  event_type         String
  payload            String
  event_order        Int
  request_user_email String?
  success            Boolean
  failure_reason     String  @default("")
  created_at         Float // unix epoch milliseconds, written by the API

  @@index([request_id])
  @@index([created_at])
}
