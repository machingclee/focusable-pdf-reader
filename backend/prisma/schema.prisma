// Prisma schema for the PDF Focus Viewer backend.
// The connection URL lives in prisma.config.ts, not here.
//
// Model and field names are also the database names: there is no @map / @@map
// to keep in sync, so snake_case here is snake_case in SQLite and in the
// generated client.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  runtime      = "bun"
  moduleFormat = "esm"
}

datasource db {
  provider = "sqlite"
}

/// One opened PDF. `ordering` is its drag position in the notes list, rewritten
/// as 0..n-1 when the reader reorders the documents. A new document is placed
/// first, so the list stays newest-first until it is dragged.
model pdf_document {
  id               Int               @id @default(autoincrement())
  name             String // editable later
  file_path        String            @unique
  fingerprint      String? // pdf.js fingerprint of the copy, recorded when it is opened
  page_count       Int?
  /// sha256 of the bytes; the copy is library/<content_hash>.pdf
  content_hash     String?           @unique
  /// where the file was imported from, shown in the UI only
  original_path    String?
  /// Drag position in the notes list, 0 first. A new document is placed first.
  ordering         Int
  created_at       Float // unix epoch milliseconds, written by the API
  note_folders     note_folder[]
  notes            note[]
  /// Yellow strokes on this document's pages. The document owns them: a mark is
  /// not saved on a strip, and deleting the document deletes its marks.
  highlights       highlight[]
  /// The tags on this document, through the assignment junction.
  assigned_tags    rel_pdf_document_assigned_pdf_tag[]
  /// The singleton settings row, when this document is the last one resolved.
  last_opened_from app_state[]
  /// Memberships that file this document in one or more document folders.
  folder_memberships rel_pdf_document_folder_pdf_document[]

  @@index([id])
  @@index([ordering])
}

/// A named group of notes inside one document. The document owns its note
/// folders; a note folder owns its notes. `ordering` is the drag position among
/// the document's note folders, rewritten as 0..n-1 when the user reorders them.
model note_folder {
  id              Int          @id @default(autoincrement())
  pdf_document_id Int
  pdf_document    pdf_document @relation(fields: [pdf_document_id], references: [id], onDelete: Cascade)
  name            String
  ordering        Int
  created_at      Float // unix epoch milliseconds, written by the API
  notes           note[]

  @@index([id])
  @@index([pdf_document_id, ordering])
}

/// A saved note. It belongs to one document; its note folder is optional, so a
/// note can sit outside every note folder. `ordering` is the drag position
/// among the notes that share a home, note folder or not.
model note {
  id              Int          @id @default(autoincrement())
  pdf_document_id Int
  pdf_document    pdf_document @relation(fields: [pdf_document_id], references: [id], onDelete: Cascade)
  /// Null means the note is in no note folder.
  note_folder_id  Int?
  note_folder     note_folder? @relation(fields: [note_folder_id], references: [id], onDelete: Cascade)
  ordering        Int // drag position among the notes of this note folder, 0..n-1
  page_number     Int // 1-based, same as data-page
  top             Float // position on the page in PDF points, so zoom doesn't matter
  height          Float
  left            Float // column edges, used to place the note marker
  width           Float
  page_width      Float
  page_height     Float
  text_excerpt    String? // first ~200 chars: list label and backup locator
  remark          String       @default("") // markdown
  /// Open by default. Folded, the writing under the preview is hidden. The
  /// preview stays: a note that only exists so another note can point at it
  /// has no writing to put the control on.
  expanded        Boolean      @default(true)
  created_at      Float // unix epoch milliseconds, written by the API

  @@index([note_folder_id, ordering])
  @@index([pdf_document_id, ordering])
}

/// One horizontal yellow stroke on a document's page, in PDF points.
///
/// The document is the aggregate. `page_number` is 1-based, the same as a
/// strip's page. `x0` and `x1` are the ends, `y` is the top edge from the top
/// of that page, and `size` is the thickness. Deleting the document deletes
/// its marks. A strip does not own any.
model highlight {
  id              Int          @id @default(autoincrement())
  pdf_document_id Int
  pdf_document    pdf_document @relation(fields: [pdf_document_id], references: [id], onDelete: Cascade)
  page_number     Int
  x0              Float
  x1              Float
  y               Float
  size            Float
  created_at      Float // unix epoch milliseconds, written by the API

  @@index([id])
  @@index([pdf_document_id, page_number])
}

/// The one remembered UI row. Each column is one setting.
///
/// `id` is always 1. A new setting is a new column, and a patch writes only the
/// columns it names. `last_opened_pdf_document_id` is written by `PdfPolicy`
/// when a document is resolved, not by the reader.
model app_state {
  id                          Int           @id
  /// Width of the "Notes of this PDF" column, in CSS px.
  notes_panel_width           Int?
  /// Width of the event-log column, in CSS px.
  event_log_panel_width       Int?
  /// Width of the Documents rail in the Notes tab, in CSS px.
  notes_documents_width       Int?
  last_opened_pdf_document_id Int?
  last_opened_pdf_document    pdf_document? @relation(fields: [last_opened_pdf_document_id], references: [id], onDelete: SetNull)
  updated_at                  Float // unix epoch milliseconds, written by the API

  @@index([id])
}

/// Command and event rows written after each top-level command commits or rolls back.
model event_audit {
  id                 Int     @id @default(autoincrement())
  request_id         String
  event_type         String
  payload            String
  event_order        Int
  request_user_email String?
  success            Boolean
  failure_reason     String  @default("")
  created_at         Float // unix epoch milliseconds, written by the API

  @@index([request_id])
  @@index([created_at])
}

/// A named group of documents in the Documents rail. One document can sit in
/// several folders. A document with no membership is Ungrouped, which is not a
/// row here. Deleting a folder does not delete its documents; a nonempty delete
/// is refused before the membership cascade can stick.
model pdf_document_folder {
  id           Int                                      @id @default(autoincrement())
  name         String
  /// Case-insensitive identity, written by the API.
  name_lower   String                                   @unique
  ordering     Int
  created_at   Float // unix epoch milliseconds, written by the API
  memberships  rel_pdf_document_folder_pdf_document[]

  @@index([id])
  @@index([ordering])
}

/// One filing of a document in a document folder. `ordering` is the drag
/// position of that document inside that folder, rewritten as 0..n-1.
model rel_pdf_document_folder_pdf_document {
  id                     Int                 @id @default(autoincrement())
  pdf_document_folder_id Int
  pdf_document_folder    pdf_document_folder @relation(fields: [pdf_document_folder_id], references: [id], onDelete: Cascade)
  pdf_document_id        Int
  pdf_document           pdf_document        @relation(fields: [pdf_document_id], references: [id], onDelete: Cascade)
  ordering               Int
  created_at             Float // unix epoch milliseconds, written by the API

  @@unique([pdf_document_folder_id, pdf_document_id])
  @@index([pdf_document_folder_id])
  @@index([pdf_document_id])
  @@index([pdf_document_folder_id, ordering])
}

/// A folder that groups PDF tags. Not the notes `folder`, which groups strips
/// inside one PDF: this one groups the tag catalog, and nothing else.
///
/// `ordering` is the drag position among tag folders, rewritten as 0..n-1 when
/// the list is reordered. `name_lower` is the case-insensitive identity, written
/// by the API, because SQLite has no case-insensitive unique index through Prisma.
model pdf_tag_folder {
  id         Int      @id @default(autoincrement())
  name       String
  name_lower String   @unique
  ordering   Int
  created_at Float // unix epoch milliseconds, written by the API
  tags       pdf_tag[]

  @@index([id])
  @@index([ordering])
}

/// One tag of PDF documents. Its folder is optional, so deleting a folder keeps
/// its tags (they move to "Ungrouped"), and a document tags only ever the tag.
model pdf_tag {
  id                Int             @id @default(autoincrement())
  name              String
  name_lower        String          @unique
  pdf_tag_folder_id Int?
  pdf_tag_folder    pdf_tag_folder? @relation(fields: [pdf_tag_folder_id], references: [id], onDelete: SetNull)
  created_at        Float // unix epoch milliseconds, written by the API
  assignments       assigned_pdf_tag[]

  @@index([id])
  @@index([pdf_tag_folder_id])
}

/// One assignment of a tag. It deliberately has no `pdf_document_id`: who the
/// tag is assigned to lives in the junction below, the counterpart of the
/// reference project's `rel_shellscript_tag`. An assignment row is created for
/// exactly one document and removed when that document loses the tag, so the
/// row never outlives its single link.
model assigned_pdf_tag {
  id         Int      @id @default(autoincrement())
  pdf_tag_id Int
  pdf_tag    pdf_tag  @relation(fields: [pdf_tag_id], references: [id], onDelete: Cascade)
  created_at Float // unix epoch milliseconds, written by the API
  documents  rel_pdf_document_assigned_pdf_tag[]

  @@index([id])
  @@index([pdf_tag_id])
}

/// The junction between a PDF document and an assignment.
///
/// Owning side: creating a junction row is what assigns, deleting its
/// `assigned_pdf_tag` row is what unassigns (the junction cascades). The unique
/// pair keeps a document from listing the same assignment twice.
model rel_pdf_document_assigned_pdf_tag {
  id                  Int              @id @default(autoincrement())
  pdf_document_id     Int
  pdf_document        pdf_document     @relation(fields: [pdf_document_id], references: [id], onDelete: Cascade)
  assigned_pdf_tag_id Int
  assigned_pdf_tag    assigned_pdf_tag @relation(fields: [assigned_pdf_tag_id], references: [id], onDelete: Cascade)
  created_at          Float // unix epoch milliseconds, written by the API

  @@unique([pdf_document_id, assigned_pdf_tag_id])
  @@index([pdf_document_id])
  @@index([assigned_pdf_tag_id])
}
