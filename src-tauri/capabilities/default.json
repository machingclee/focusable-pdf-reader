{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for every full app window, the notes window it can pop out, the viewer windows a note reference opens, and a document opened in a window of its own",
  "windows": [
    "main",
    "app-*",
    "notes",
    "notes-app-*",
    "viewer-note-*",
    "viewer-doc-*"
  ],
  "permissions": [
    "core:default",
    "core:menu:default",
    "core:window:allow-set-title",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:webview:allow-create-webview-window",
    "core:window:allow-set-focus",
    "core:window:allow-close",
    "allow-open-in-vscode",
    "allow-get-backend-info",
    "allow-note-images",
    "allow-write-and-open-html",
    "opener:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "vscode://*"
        },
        {
          "url": "http://127.0.0.1:*/*"
        },
        {
          "url": "http://127.0.0.1:*/*/"
        },
        {
          "url": "http://localhost:*/*"
        },
        {
          "url": "http://localhost:*/*/"
        }
      ]
    },
    "dialog:default",
    "fs:allow-read-file",
    {
      "identifier": "fs:scope",
      "allow": [
        {
          "path": "$HOME/**"
        },
        {
          "path": "$DOCUMENT/**"
        },
        {
          "path": "$DOWNLOAD/**"
        },
        {
          "path": "$DESKTOP/**"
        },
        {
          "path": "$APPDATA/**"
        }
      ]
    }
  ]
}
