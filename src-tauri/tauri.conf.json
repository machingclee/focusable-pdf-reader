{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PDF Focus Viewer",
  "mainBinaryName": "PDF Focus Viewer",
  "version": "0.1.1",
  "identifier": "com.machingclee.pdf-focus-viewer",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PDF Focus Viewer",
        "width": 1200,
        "height": 860,
        "minWidth": 720,
        "minHeight": 480,
        "allowLinkPreview": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "externalBin": ["binaries/pdf-backend"],
    "resources": {
      "../backend/node_modules/@machingclee/express-cqrs/dist/event-storming/public/": "event-storming/"
    },
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
